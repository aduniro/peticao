[Unit]
Description=Replicate admin-v2 queue checkpoint to passive Sao Paulo
After=network-online.target admin-v2-coordinator.service
[Service]
Type=oneshot
User=vigia-coord
Group=admin-v2-exec
ExecStart=/usr/bin/python3 /opt/admin-v2-cluster/replicate.py
UMask=0077
CPUQuota=25%
MemoryMax=768M
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=1200
