# Explicit qualification profile. Node20 Dockerfile remains the default rollback profile.
# This is the official linux/amd64 manifest, not a mutable tag or the multiarch index.
FROM node:22.23.5-bookworm-slim@sha256:47725aca53d3295ec2d3be8f62726599b3033cc262edc2c7e429909b3ac599fc
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --chown=node:node runtime/ /app/
RUN mkdir -p /app/data && chown node:node /app/data
USER node
CMD ["node", "node_modules/next/dist/bin/next", "start", "-H", "127.0.0.1", "-p", "3001"]
