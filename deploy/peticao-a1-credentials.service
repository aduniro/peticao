[Unit]
Description=Cadastro protegido de certificados A1 da ADUNIR
After=systemd-tmpfiles-setup.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peticao-signing
Group=peticao-a1-web
UMask=0077
Environment=A1_CREDENTIAL_CONFIG=/etc/peticao-signing/credentials.json
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/peticao-signing/venv/bin/python /opt/peticao-signing/credential_service.py
WorkingDirectory=/
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/peticao-signing /run/peticao-signing
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
LimitCORE=0
MemoryMax=1G
TasksMax=32
CPUQuota=200%
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
