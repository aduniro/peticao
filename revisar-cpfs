import os,subprocess,time,urllib.request,urllib.error
from pathlib import Path
base=Path('/mnt/dev/cpfs/revisao');port=int(os.environ.get('CPF_REVIEW_PORT','8765'));url=f'http://127.0.0.1:{port}'
def ready():
 try:urllib.request.urlopen(url,timeout=1);return True
 except urllib.error.HTTPError as e:return e.code==403
 except Exception:return False
if not ready():
 with (base/'servidor.log').open('a') as log:
  subprocess.Popen(['/usr/bin/python3','/mnt/dev/peticao/tools/cpf-review/server.py'],stdout=log,stderr=log,stdin=subprocess.DEVNULL,start_new_session=True,env=dict(os.environ,PYTHONDONTWRITEBYTECODE='1'))
 for _ in range(100):
  if ready():break
  time.sleep(.2)
 if not ready():raise SystemExit('A revisão não iniciou. Consulte /mnt/dev/cpfs/revisao/servidor.log')
token=(base/'.access-token').read_text()
if '--no-open' not in __import__('sys').argv:
 subprocess.Popen(['xdg-open',url+'/?token='+token],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
print('Revisão local disponível em '+url+'. Use este comando para abrir com autenticação.')
