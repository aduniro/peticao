{
  "name": "peticao-laboratorio",
  "services": {
    "db-a": {
      "image": "postgres:17-bookworm",
      "environment": {
        "POSTGRES_USER": "peticao",
        "POSTGRES_PASSWORD": "QA-LAB-DB-FICTITIOUS",
        "POSTGRES_DB": "peticao"
      },
      "volumes": [
        "db-a-data:/var/lib/postgresql/data"
      ],
      "networks": [
        "lab-a"
      ],
      "mem_limit": "512m",
      "cpus": 0.5,
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "peticao",
          "-d",
          "peticao"
        ],
        "interval": "2s",
        "timeout": "3s",
        "retries": 30
      },
      "restart": "unless-stopped"
    },
    "app-a": {
      "image": "peticao-laboratorio:a",
      "environment": {
        "NODE_ENV": "production",
        "PREVIEW_MODE": "1",
        "HASH_PEPPER": "QA-LAB-PEPPER-FICTITIOUS-NEVER-PRODUCTION-20261108",
        "ADMIN_PASSWORD": "QA-LAB-ADMIN-NOT-PRODUCTION-20261108",
        "CPF_CACHE_ENCRYPTION_KEY": "QA-LAB-CACHE-KEY-NOT-PRODUCTION-20261108",
        "DATA_ENCRYPTION_KEY": "QA-LAB-DATA-KEY-FICTITIOUS-20261108",
        "MAIL_PROVIDER": "dev",
        "MAIL_PROVIDERS": "dev",
        "MAIL_OUTBOX_DIR": "/outbox",
        "CONTACT_TO": "qa-contact@example.invalid",
        "CONTACT_BCC": "",
        "RECIPIENTS": "",
        "APPROVER_EMAIL": "",
        "MAIL_PROVIDERS_MARKETING": "",
        "SECRETS_DIR": "/empty",
        "PETICAO_CONFIG_DIR": "/empty",
        "CREDENTIALS_DIRECTORY": "/empty",
        "NEXT_TELEMETRY_DISABLED": "1",
        "TURNSTILE_SITE_KEY": "QA-LAB-SITE",
        "TURNSTILE_SECRET_KEY": "QA-LAB-SECRET",
        "CPF_FORCE_MOCK": "1",
        "CPF_MOCK_DATA": "{\"52998224725\": {\"nome\": \"PESSOA FICTICIA TESTE\", \"nasc\": \"15/08/1985\", \"mae\": \"ANA MARIA DA CONCEICAO\", \"sexo\": \"F\"}, \"11144477735\": {\"nome\": \"PESSOA FICTICIA TESTE\", \"nasc\": \"15/08/1985\", \"mae\": \"ANA MARIA DA CONCEICAO\", \"sexo\": \"F\"}}",
        "DATABASE_URL": "postgres://peticao:QA-LAB-DB-FICTITIOUS@db-a:5432/peticao",
        "APP_URL": "http://127.0.0.1:3040",
        "LAB_VARIANT": "a"
      },
      "depends_on": {
        "db-a": {
          "condition": "service_healthy"
        }
      },
      "ports": [
        "127.0.0.1:3040:8080"
      ],
      "volumes": [
        "/mnt/dev/peticao-laboratorio/tools:/lab:ro",
        "/mnt/dev/peticao-laboratorio/runtime/geo-data:/app/geo-data:ro",
        "/mnt/dev/peticao-laboratorio/runtime/empty:/empty:ro",
        "/mnt/dev/peticao-laboratorio/runtime/a/outbox:/outbox"
      ],
      "networks": [
        "lab-a"
      ],
      "mem_limit": "768m",
      "cpus": 1,
      "init": true,
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ]
    },
    "db-b": {
      "image": "postgres:17-bookworm",
      "environment": {
        "POSTGRES_USER": "peticao",
        "POSTGRES_PASSWORD": "QA-LAB-DB-FICTITIOUS",
        "POSTGRES_DB": "peticao"
      },
      "volumes": [
        "db-b-data:/var/lib/postgresql/data"
      ],
      "networks": [
        "lab-b"
      ],
      "mem_limit": "512m",
      "cpus": 0.5,
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "peticao",
          "-d",
          "peticao"
        ],
        "interval": "2s",
        "timeout": "3s",
        "retries": 30
      },
      "restart": "unless-stopped"
    },
    "app-b": {
      "image": "peticao-laboratorio:b",
      "environment": {
        "NODE_ENV": "production",
        "PREVIEW_MODE": "1",
        "HASH_PEPPER": "QA-LAB-PEPPER-FICTITIOUS-NEVER-PRODUCTION-20261108",
        "ADMIN_PASSWORD": "QA-LAB-ADMIN-NOT-PRODUCTION-20261108",
        "CPF_CACHE_ENCRYPTION_KEY": "QA-LAB-CACHE-KEY-NOT-PRODUCTION-20261108",
        "DATA_ENCRYPTION_KEY": "QA-LAB-DATA-KEY-FICTITIOUS-20261108",
        "MAIL_PROVIDER": "dev",
        "MAIL_PROVIDERS": "dev",
        "MAIL_OUTBOX_DIR": "/outbox",
        "CONTACT_TO": "qa-contact@example.invalid",
        "CONTACT_BCC": "",
        "RECIPIENTS": "",
        "APPROVER_EMAIL": "",
        "MAIL_PROVIDERS_MARKETING": "",
        "SECRETS_DIR": "/empty",
        "PETICAO_CONFIG_DIR": "/empty",
        "CREDENTIALS_DIRECTORY": "/empty",
        "NEXT_TELEMETRY_DISABLED": "1",
        "TURNSTILE_SITE_KEY": "QA-LAB-SITE",
        "TURNSTILE_SECRET_KEY": "QA-LAB-SECRET",
        "CPF_FORCE_MOCK": "1",
        "CPF_MOCK_DATA": "{\"52998224725\": {\"nome\": \"PESSOA FICTICIA TESTE\", \"nasc\": \"15/08/1985\", \"mae\": \"ANA MARIA DA CONCEICAO\", \"sexo\": \"F\"}, \"11144477735\": {\"nome\": \"PESSOA FICTICIA TESTE\", \"nasc\": \"15/08/1985\", \"mae\": \"ANA MARIA DA CONCEICAO\", \"sexo\": \"F\"}}",
        "DATABASE_URL": "postgres://peticao:QA-LAB-DB-FICTITIOUS@db-b:5432/peticao",
        "APP_URL": "http://127.0.0.1:3041",
        "LAB_VARIANT": "b"
      },
      "depends_on": {
        "db-b": {
          "condition": "service_healthy"
        }
      },
      "ports": [
        "127.0.0.1:3041:8080"
      ],
      "volumes": [
        "/mnt/dev/peticao-laboratorio/tools:/lab:ro",
        "/mnt/dev/peticao-laboratorio/runtime/geo-data:/app/geo-data:ro",
        "/mnt/dev/peticao-laboratorio/runtime/empty:/empty:ro",
        "/mnt/dev/peticao-laboratorio/runtime/b/outbox:/outbox"
      ],
      "networks": [
        "lab-b"
      ],
      "mem_limit": "768m",
      "cpus": 1,
      "init": true,
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ]
    }
  },
  "networks": {
    "lab-a": {
      "internal": true
    },
    "lab-b": {
      "internal": true
    }
  },
  "volumes": {
    "db-a-data": {},
    "db-b-data": {}
  }
}
